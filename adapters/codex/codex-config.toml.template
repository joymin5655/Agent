# Codex CLI configuration template.
# Copy to ~/.codex/config.toml (or merge into existing).
# Replace {{FRAMEWORK_ROOT}} with the absolute path to your Agent/ checkout.

# Native Codex sandbox configuration. Instruction files do not enforce gates.
sandbox_mode = "workspace-write"

[sandbox_workspace_write]
network_access = false

# The shell wrapper is an explicit compatibility tool, not an automatically wired
# Codex shell replacement. Do not use obsolete [tools.shell] or [sandbox] tables.
# See adapters/codex/README.md for coverage limitations.

# Skills directory (optional — set if using ~/.codex/skills layout).

# Model tier profiles (docs/model-routing.md). The unprefixed default model is
# the workhorse (MID) tier (GPT-6 family as of 2026-09 — Astra/Luna; GPT-5.x retired);
# the LOW and TOP rungs are reached with
# `codex --profile quick` / `codex --profile deep`.
# Recent Codex CLI builds reject inline `[profiles.*]` tables as legacy —
# each profile lives in its own file next to config.toml instead:
#   ~/.codex/quick.config.toml  (see quick.config.toml.template)
#   ~/.codex/deep.config.toml   (see deep.config.toml.template)
# Raise model_reasoning_effort within a rung before promoting a rung up.

# Agent-brain MCP server (core/brain/brain-mcp.py) — the shared cross-AI
# knowledge store. Read tools (brain_search / brain_get / brain_neighbors /
# brain_stats) + brain_capture, which writes the raw/ quarantine ONLY (never a
# curated note or the vault). The SAME server is registered for Claude and
# Gemini, so all three CLIs query one brain. Stdlib only — no pip install.
# As the final table header, nothing below can bleed into it.
[mcp_servers.brain]
command = "python3"
args = ["{{FRAMEWORK_ROOT}}/core/brain/brain-mcp.py"]
