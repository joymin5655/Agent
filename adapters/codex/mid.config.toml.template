# Codex profile: MID tier — ordinary implementation, debugging, investigation.
# Copy to ~/.codex/mid.config.toml; invoke with `codex --profile mid`.
# Model ID is a snapshot of the default family (sol). The pin drifts as the
# vendor ships and retires models: `python3 core/infra/codex-models.py check`
# compares it with codex's own catalog and `apply` updates it after a probe.
# (docs/model-routing.md)
model = "gpt-6.1-sol"
model_reasoning_effort = "medium"

# Worker lanes run at standard speed. A base ~/.codex/config.toml that turns on
# Fast mode (service_tier) is inherited by every profile and spends more plan
# usage per task; turning the Fast/Ultrafast feature off drops that tier for
# this profile only (measured on codex-cli 0.170.0: thread_settings.service_tier
# "priority" without this table, absent with it). (docs/model-routing.md)
[features]
fast_mode = false
ultrafast_mode = false
