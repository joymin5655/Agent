# hook-config.yml — per-project customisation for the agent framework.
#
# Copy this file to `.agent/hook-config.yml` (or `.agent/hook-config.json` for the same
# keys without PyYAML) in your project root and edit. The hooks read it on every invocation, so
# changes take effect immediately. A copy at the project root is NOT read by any hook.
#
# All fields are OPTIONAL — defaults are documented inline. Each field says whether it is LIVE
# (a hook reads it) or NOT WIRED (documentation of intent only).
#
# EXTENSION-ONLY: every live field here ADDS to the built-in patterns. Nothing in this file can
# remove a built-in pattern, lower a decision below a consumer's floor, or turn an advisory off.
# Regexes are Python `re` syntax, at most 200 chars, tested with `search` against a repo-relative
# path; a bad one (invalid, nested quantifier such as `(a+)+` or a character class followed by
# + or *, or one that matches the empty string) is ignored with a stderr warning.
# PyYAML missing: the yml is skipped with a warning and the built-ins apply (json still works).

# ---------------------------------------------------------------------------
# Risk areas — the 5 areas that automation must never act on unilaterally.
# See rules/policy/security-guards.md for the policy.
# ---------------------------------------------------------------------------
risk_areas:
  data:
    # LIVE — read by pre-tool-guard (a Bash command that modifies a matching path asks),
    # pre-push (advisory report) and auto-ship (aborts, exit 12). A string or a list; UNIONed
    # with the built-in `^.*/migrations/.*\.sql$` (pre-push, auto-ship) and the built-in
    # DROP/TRUNCATE TABLE ask (pre-tool-guard) — it never replaces them.
    pattern: '^.*/migrations/.*\.sql$'
    # advisory | ask | deny. Raises the consumer's floor, never lowers it: pre-push is advisory
    # by default, pre-tool-guard asks by default, auto-ship already aborts. `deny` happens ONLY
    # when written here (pre-push then blocks the push, exit 12; pre-tool-guard denies).
    decision: ask

  secrets:
    # LIVE — Files / patterns that constitute secret leak. ALWAYS deny — no override.
    # (read by the Bash guard 11b and tdd-guard; fails closed without PyYAML — P1-9.)
    paths:
      - 'secrets/**'
      - '.env'
      - '.env.local'
      - '.env.production'
    # NOT WIRED — `keywords` is documentation of intent only. secret-content-scan.py takes extra
    # key names from `python_hooks.credential_key_names` (see the secret-scan block below).
    keywords:
      - SERVICE_ROLE_KEY
      - API_TOKEN
      - API_KEY
      - STRIPE_SECRET_KEY
      - POLAR_API_KEY
      - PRIVATE_KEY
    decision: deny

  deploy:
    # LIVE — Function / worker / deploy bundles. Same consumers and rules as `data`.
    pattern: '^.*/functions/.*/index\.ts$'
    decision: ask

  payment:
    # LIVE — Billing / payment code. pre-tool-guard and pre-push have no built-in payment
    # pattern, so this one only takes effect when you list it; auto-ship also has a built-in
    # `(billing/|stripe|polar|iap|revenue-cat)` this is added to.
    pattern: '(billing/|stripe|polar|iap|revenue-cat)'
    decision: ask

  domain-output:
    # NOT WIRED — auto-ship reads RISK_DOMAIN_OUTPUT_PATTERN (env) only, not this field.
    # Project-specific: uncertainty / quality / signed-prediction fields
    # whose net removal should block. Empty = no check.
    pattern: '(uncertainty|confidence_p\d+|grade_letter)'
    decision: advisory   # advisory | ask | deny

# ---------------------------------------------------------------------------
# Resource mutex — see rules/multi-agent-worktree.md R4.
# LIVE — read by r4-mutex-check.sh. `triggers` are regexes tested against a Bash command or an
# MCP tool name; a match makes the call contend for the lock named by the key (name:
# [a-z0-9][a-z0-9_.-]*). Triggers are consulted only when no BUILT-IN trigger matched, so they
# add resources; they cannot re-route or suppress a built-in one. The names below mirror the
# built-ins, so these entries are examples; add your own resource names here.
# `auto_expire_minutes` is NOT honoured (removed): an expiry would shorten a lock's hold, which
# weakens the mutex. Locks are released with `agent-session.sh release` / gc.
# ---------------------------------------------------------------------------
resources:
  production-db:
    triggers:
      - 'supabase db push'
      - 'supabase migration (up|apply)'
      - 'mcp__supabase__apply_migration'

  edge-function-deploy:
    triggers:
      - 'supabase functions deploy'
      - 'mcp__supabase__deploy_edge_function'

  production-deploy:
    triggers:
      - 'wrangler pages deploy'
      - 'fly deploy'
      - 'gh workflow run .*deploy.*'

# ---------------------------------------------------------------------------
# Hardcoding policy — paths exempt from check-hardcoding.py / check-staged.py.
# NOT YET WIRED (declarative documentation only — backlog T-4). The live knob
# is the env var AGENT_HARDCODING_MODE=off|dryrun|block (default dryrun:
# advisory + jsonl log, never blocks; block restores the hard deny).
# ---------------------------------------------------------------------------
hardcoding:
  exempt_globs:
    - 'config.ts'
    - 'config.js'
    - 'types.ts'
    - 'types.js'
    - 'tailwind.config.*'
    - 'vite.config.*'
    - 'tsconfig*'
    - '.test.*'
    - '.spec.*'
    - 'test/'
    - '__tests__/'
    - 'docs/'
    - 'wiki/'

  scan_extensions:
    - .ts
    - .tsx
    - .js
    - .jsx
    - .py

# ---------------------------------------------------------------------------
# Session coordination
# ---------------------------------------------------------------------------
session:
  heartbeat_interval_seconds: 300
  stale_after_minutes: 30
  worktree_prefix: '.worktrees'
  lock_dir: '.agent/locks'
  log_dir: '.agent/logs'
  # completion_tests — LIVE (read by core/hooks/session-quality-gate.py, P3-1).
  # Shell commands run on the FIRST Stop of a response. If any exits non-zero
  # (or times out), the session is blocked from ending until it passes — you
  # cannot claim "done" while tests fail. A second Stop passes (intentional
  # override), as does AGENT_QUALITY_GATE_BLOCK=0 (advisory). The hook's
  # subjective STYLE scan (inline types / hex colors / console.log) is
  # advisory-only by default and never blocks — opt back into style blocking
  # with AGENT_QUALITY_STYLE_BLOCK=1. Commands run at
  # the project's OWN trust level (same as your package.json scripts); unset or
  # empty = the completion gate does nothing. Per-command timeout:
  # AGENT_COMPLETION_TEST_TIMEOUT seconds (default 120).
  completion_tests: []
  #   - "npm test --silent"
  #   - "npx tsc --noEmit"

# ---------------------------------------------------------------------------
# Goal mode (supervisor-goal.sh)
# ---------------------------------------------------------------------------
goal_mode:
  default_budget: null   # null = no budget; integer = token budget
  graceful_wrap_wiki_dir: 'wiki/synthesis'
  graceful_wrap_memory_dir: null   # set to enable optional memory stub

# ---------------------------------------------------------------------------
# Optional: project-specific hook script overrides
# ---------------------------------------------------------------------------
# hooks:
#   pre_tool_guard: 'custom/my-pre-tool-guard.sh'
#   secret_content_scan: 'custom/my-secret-scan.py'

# ---------------------------------------------------------------------------
# Secret-scan extensions — loaded at runtime by core/hooks/hook_config.py from
# `.agent/hook-config.yml` (copy this file there to activate). The runtime-live
# parts of this file are this block, `session.completion_tests`, `risk_areas.secrets.paths`,
# `risk_areas.data/deploy/payment` and `resources.<name>.triggers`; everything else
# (`secrets.keywords`, `domain-output`, `hardcoding:`, the rest of `session:`) is
# declarative documentation only, not read by any hook. See docs/customization.md part 2.
#
# ADDITIVE ONLY: these entries can only ADD secret patterns / exempt paths /
# credential key names on top of secret-content-scan.py's built-ins. There is
# no way to remove, disable, or weaken a built-in, or flip deny -> allow.
#
# Uncomment and edit to activate:
#
# LIVE-SCHEMA-EXAMPLE-BEGIN
# python_hooks:
#   secret_patterns:                 # [regex, label] pairs — not {id, regex} objects
#     - ["myservice_(live|test)_[a-zA-Z0-9_-]{32,}", "MyService API token"]
#   exempt_paths:                    # substring fragments; each needs >=1 run of 3+ alnum chars
#     - "vendor/fixtures/"
#   credential_key_names:            # plain strings, folded into one extra KEY=value pattern
#     - "MYSERVICE_TOKEN"
# LIVE-SCHEMA-EXAMPLE-END

# NOTE (not a config key): plan-scope-allow.py — the plan-approved auto-allow
# accelerator — is deliberately NOT configurable here. Weakening sources must
# stay outside anything the agent can edit in-repo. Activation is 3-way:
#   export AGENT_PLAN_ALLOW_MODE=on    # force active
#   export AGENT_PLAN_ALLOW_MODE=off   # force dark (any non-"on" value)
#   (unset)                            # per-project trust tier decides:
#     active only for "personal" workspaces per the USER-SIDE
#     ~/.agent/trust.list (templates/trust.list.template — outside every
#     workspace, so editing it always prompts). A repo-side .agent/trust-tier
#     file can only DOWNGRADE to collab. See docs/customization.md § Trust tiers.
